    "decimal.js": "^10.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
