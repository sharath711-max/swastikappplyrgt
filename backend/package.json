{
  "name": "backend",
  "private": true,
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "logs:maintain": "node scripts/log_maintenance.js",
    "report:restore-drill": "node scripts/backup_restore_drill_report.js",
    "report:media": "node scripts/media_verification_report.js",
    "report:migration": "node scripts/migration_acceptance_report.js",
    "test": "jest --runInBand tests/unit tests/integration",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:workflow": "node test_workflows.js",
    "test:workflow:v2": "node test_workflows_v2.js",
    "test:watch": "jest --watch tests/unit tests/integration"
  },
  "bin": "app.js",
  "pkg": {
    "scripts": "app.js",
    "assets": [
      "public/**/*",
      "db/init.sql",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.5.0",
    "chokidar": "5.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
